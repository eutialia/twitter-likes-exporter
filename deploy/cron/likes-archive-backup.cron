# /etc/cron.d/likes-archive-backup
#
# Nightly Postgres metadata backup written under MEDIA_ROOT/backups so the NAS
# ZFS snapshot also captures the DB dump alongside media files.
#
# Prerequisites:
#   - The 'likes' user must be able to connect to Postgres (DATABASE_URL in env).
#   - pg_dump must be on PATH for the 'likes' user (install postgresql-client in the LXC).
#
# Note: the backups directory is created automatically by the dump line below.
# Note: DATABASE_URL uses the postgresql+asyncpg:// dialect for SQLAlchemy.
#   The +asyncpg driver suffix is stripped before passing to pg_dump, which
#   only accepts libpq schemes (postgresql:// or postgres://).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 03:00 — dump and compress (strip +asyncpg so pg_dump gets a plain libpq URL)
0 3 * * *  likes  . /etc/likes-archive/secrets.env && mkdir -p /mnt/media/likes/backups && pg_dump "${DATABASE_URL/+asyncpg/}" | gzip > /mnt/media/likes/backups/likes_archive_$(date +\%Y-\%m-\%d).sql.gz

# 03:30 — remove dumps older than 30 days
30 3 * * * likes  find /mnt/media/likes/backups -name '*.sql.gz' -mtime +30 -delete
